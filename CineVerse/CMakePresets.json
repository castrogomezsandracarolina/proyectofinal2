{
  "version": 5,
  "configurePresets": [
    {
      "name": "consola",
      "displayName": "CineVerse C++ (sin Qt)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/consola",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CINEVERSE_CON_QT": "OFF"
      }
    },
    {
      "name": "qt6-windows",
      "displayName": "CineVerse Qt 6 Widgets - Windows",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/qt6",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CINEVERSE_CON_QT": "ON",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.12.0/mingw_64"
      }
    }
  ],
  "buildPresets": [
    { "name": "consola", "configurePreset": "consola" },
    { "name": "qt6-windows", "configurePreset": "qt6-windows", "targets": ["CineVerseQt"] }
  ]
}
